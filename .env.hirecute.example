# Settings for running hirecute on this computer (./up.sh or up.cmd).
#
# `up` copies this file to .env.hirecute.local the first time. Put your model
# key in THAT file. It is never committed (.gitignore); this example is.
#
# The local address (http://127.0.0.1:8080) is set by `up` itself. Do not add
# HIRECUTE_BASE_URL here.

# ── Model ───────────────────────────────────────────────────────────────────
HIRECUTE_MODEL_API_BASE_URL=https://api.anthropic.com/v1
HIRECUTE_MODEL=claude-sonnet-5
# Paste the key after the "=" (one line, no quotes, no spaces).
HIRECUTE_MODEL_API_KEY=

# ── Resume parse ────────────────────────────────────────────────────────────
# Paged parse on the fast model, falling back to HIRECUTE_MODEL whenever a
# check fails (recruiter scenario). Delete these three lines for the original
# single call.
HIRECUTE_PARSE_MODE=paged
HIRECUTE_MODEL_FAST=claude-haiku-5-5
HIRECUTE_MODEL_FAST_THINKING=off

# ── Scenarios ───────────────────────────────────────────────────────────────
# Which journeys exist and how new visitors are split between them (sum 100).
# `up <scenario>` opens one directly, whatever the split.
HIRECUTE_SCENARIO_PARAM=t
HIRECUTE_SCENARIOS=vacancy=50;recruiter=50
